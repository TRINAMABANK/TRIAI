# =============================================================================
# TRÍ AI — SAAS PLATFORM CONFIGURATION TEMPLATE (.env.example)
# PRODUCTION DOMAIN: https://banhangdinhcao.com
# =============================================================================

# 1. Server Configuration
PORT=80
NODE_ENV=production
APP_URL=https://banhangdinhcao.com
API_URL=https://banhangdinhcao.com/api
CORS_ORIGIN=https://banhangdinhcao.com,https://www.banhangdinhcao.com

# 2. Database Configuration (SQLite with WAL mode)
DATABASE_PATH=./.data/triai.db

# 3. Authentication & Security (MANDATORY IN PRODUCTION: CHANGE FROM DEFAULTS)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
MASTER_ADMIN_EMAIL=triqnnamabank@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_complex_master_admin_password

# 4. Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 5. AI Runtime & OpenAI API
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 6. Storage Abstraction
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# 7. VietQR Bank Account Details
VIETQR_BANK_CODE=OCB
VIETQR_ACCOUNT_NUMBER=0982441446
VIETQR_ACCOUNT_NAME=QUANG NHỰT TRÍ

# 8. Bank Payment Provider & Webhook Automation
# Modes: 'manual' (default) | 'sepay' | 'casso' | 'payos'
BANK_PROVIDER=manual
BANK_API_KEY=
BANK_WEBHOOK_SECRET=
PAYOS_CLIENT_ID=

# 9. SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM=support@banhangdinhcao.com
EMAIL_FROM_NAME=TRÍ AI
