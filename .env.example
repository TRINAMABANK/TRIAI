# =============================================================================
# TRÍ AI — SAAS PLATFORM CONFIGURATION (.env.example)
# =============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:5000/api

# 2. Database Configuration (SQLite local for zero-setup dev, or PostgreSQL)
DATABASE_URL=file:./.data/triai.db
# For PostgreSQL later: DATABASE_URL=postgresql://postgres:password@localhost:5432/triai_db

# 3. Authentication & Security
JWT_SECRET=triai_master_jwt_secret_dev_key_2026_qnt
JWT_EXPIRES_IN=7d
MASTER_ADMIN_EMAIL=triqnnamabank@gmail.com

# 4. AI Runtime & OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 5. Storage Abstraction
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=25

# 6. Payment Abstraction (VietQR OCB)
VIETQR_BANK_CODE=OCB
VIETQR_ACCOUNT_NUMBER=0982441446
VIETQR_ACCOUNT_NAME=QUANG NHỰT TRÍ
